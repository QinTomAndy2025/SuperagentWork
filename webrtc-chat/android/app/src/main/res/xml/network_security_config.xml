<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Self-signed certificates are confirmed by the user in the WebView
         TOFU dialog; normal HTTPS validation stays enabled. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
